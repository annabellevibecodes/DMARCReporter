#!/bin/bash

PORT=8080 \
IMAP_HOST="some.host.com" \
IMAP_PORT=993 \
IMAP_USER="user" \
IMAP_PASS="password" \
IMAP_MAILBOX="INBOX" \
IMAP_PROCESSED_MAILBOX="INBOX.Processed" \
IMAP_TLS=true \
DEBUG=false \
AUTH_DISABLED=false \
AUTH_PASSWORD=secret-password \
AUTH_FAIL_MAX=10 \
AUTH_FAIL_WINDOW=15m \
UPLOAD_RATE_MAX=20 \
FETCH_RATE_MAX=3 \
./dmarcreporter

